{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "fs:allow-home-read",
    "fs:allow-home-write",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:default",
    "autostart:default",
    "notification:default"
  ]
}
